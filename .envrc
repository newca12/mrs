use flake

# Zed's Windows-to-WSL launcher serializes this environment into a Windows
# command line. Drop build-host-only flags and desktop/prompt metadata that are
# not needed by this CLI development shell; retain host compiler/linker flags.
unset NIX_CFLAGS_COMPILE_FOR_BUILD NIX_LDFLAGS_FOR_BUILD
unset LS_COLORS GTK_PATH XCURSOR_PATH QTWEBKIT_PLUGIN_PATH XDG_DATA_DIRS
