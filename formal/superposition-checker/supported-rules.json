{
  "schema_version": 1,
  "checker_status": "prototype_non_certifying",
  "ir_schema_status": "wire_v1_verified_bounded_decoder_and_unverified_tptp_bridge",
  "rules": [
    {
      "id": "ground-unit-positive-equality-unary-predicate-whole-argument",
      "module": "superposition_checker.rs",
      "status": "verified_executable_slice",
      "description": "Positive ground unit equality rewrites the whole argument of a positive unary-predicate unit clause.",
      "production_certification": false
    },
    {
      "id": "fixed-variable-two-literal-schema",
      "module": "variable_superposition.rs",
      "status": "verified_fixed_schema",
      "description": "The fixed f(a)=b, q(X) | p(f(X)) schema, with whole-target substitution.",
      "production_certification": false
    },
    {
      "id": "general-standardized-apart-superposition-semantics",
      "module": "first_order_core.rs",
      "status": "verified_executable_replay_soundness",
      "description": "Accepted exact ordered replay preserves universal clause validity via standardized_superposition_sound, with independent parent freshening, common simultaneous one-step unifier, whole-parent substitution, arbitrary selected indices and explicit target position. Includes a manually encoded executable IR replay of archived SWV406+1:c502; the fixture is not parsed. Complete hygiene/resource refinement remains open. See RULE_CONTRACT.md.",
      "production_certification": false
    },
    {
      "id": "nullary-predicate-resolution",
      "module": "first_order_core.rs",
      "status": "verified_executable_step_and_dag_dispatch",
      "description": "Bounded exact ordered resolution on positive-left/negative-right occurrences of the same 0-ary predicate. Accepted replay proves universal validity preservation; DAG dispatch binds cited parents and conclusion to local entailment. Unit and multi-step refutations certify without empty inputs. No first-order unification or context normalization.",
      "production_certification": false
    },
    {
      "id": "exact-atom-resolution",
      "module": "first_order_core.rs",
      "status": "verified_executable_step_and_dag_dispatch",
      "description": "Positive-left/negative-right identical predicate atoms or equality atoms identical up to argument symmetry, exact ordered contexts, no pivot unification. Enables complete superposition plus exact-resolution refutation DAGs through wire v1.",
      "production_certification": false
    },
    {
      "id": "first-order-resolution",
      "module": "first_order_core.rs",
      "status": "verified_executable_step_and_dag_dispatch",
      "description": "Standardized-apart first-order binary resolution with independent parent freshening, common simultaneous one-step unifier, positive-left/negative-right unified predicate pivots or equality pivots identical up to symmetry, and exact concatenated resolvent construction. Dispatched in proof DAGs via ProofNodeKind::FirstOrderResolution; proven by standardized_first_order_resolution_sound and standardized_first_order_resolution_symmetric_sound to preserve universal validity.",
      "production_certification": false
    },
    {
      "id": "equality-resolution",
      "module": "first_order_core.rs",
      "status": "verified_executable_step_and_dag_dispatch",
      "description": "Equality resolution (reflexivity resolution) on a negative equality literal: from C | s != t where s and t unify under unifier sigma, derive C sigma. Dispatched in proof DAGs via ProofNodeKind::EqualityResolution; proven by equality_resolution_sound to preserve universal validity.",
      "production_certification": false
    },
    {
      "id": "clause-factoring",
      "module": "first_order_core.rs",
      "status": "verified_executable_step_and_dag_dispatch",
      "description": "First-order clause factoring: from C | L1 | L2 where L1 and L2 have the same polarity and their atoms unify under unifier sigma, derive (C | L1) sigma. Dispatched in proof DAGs via ProofNodeKind::Factoring; proven by clause_factoring_sound to preserve universal validity.",
      "production_certification": false
    },
    {
      "id": "equality-factoring",
      "module": "first_order_core.rs",
      "status": "verified_executable_step_and_dag_dispatch",
      "description": "Equality factoring on positive equality literals: from C | s = t | u = v where s and u unify under unifier sigma, derive (C | t != v | s = t) sigma. Dispatched in proof DAGs via ProofNodeKind::EqualityFactoring; proven by equality_factoring_sound to preserve universal validity. Symmetric equality orientations are discovered and elaborated via verified intermediate symmetry steps.",
      "production_certification": false
    },
    {
      "id": "subsumption-resolution",
      "module": "first_order_core.rs",
      "status": "verified_executable_step_and_dag_dispatch",
      "description": "Subsumption resolution (contextual literal elimination): from target clause C | L and active clause A | ~L' where L' unifies with L under unifier sigma and all other literals of A sigma match literals in C, derive C without instantiating C. Dispatched in proof DAGs via ProofNodeKind::SubsumptionResolution; proven by subsumption_resolution_sound to preserve universal validity.",
      "production_certification": false
    },
    {
      "id": "clause-weakening",
      "module": "first_order_core.rs",
      "status": "verified_executable_step_and_dag_dispatch",
      "description": "Clause weakening: from universally valid parent clause C, any superset clause D containing all literals of C is universally valid. Dispatched in proof DAGs via ProofNodeKind::Weakening; proven by clause_weakening_sound to preserve universal validity.",
      "production_certification": false
    },
    {
      "id": "demodulation",
      "module": "first_order_core.rs",
      "status": "verified_executable_step_and_dag_dispatch",
      "description": "Demodulation (unit equality rewriting): from target clause C and unit positive equality parent s = t (or t = s), replacing an occurrence of s sigma (or t sigma) at position p in literal k of C by t sigma (or s sigma) derives C with literal k rewritten, preserving all other literals and their positions. Dispatched in proof DAGs via ProofNodeKind::Demodulation; proven by demodulation_sound to preserve universal validity.",
      "production_certification": false
    },
    {
      "id": "clause-instantiation",
      "module": "first_order_core.rs",
      "status": "verified_executable_step_and_dag_dispatch",
      "description": "Clause instantiation: from universally valid parent clause C and arbitrary simultaneous substitution sigma, the instance C sigma is universally valid. Dispatched in proof DAGs via ProofNodeKind::Instantiation; proven by instantiation_sound and clause_valid_after_substitution to preserve universal validity.",
      "production_certification": false
    },
    {
      "id": "clause-condensation",
      "module": "first_order_core.rs",
      "status": "verified_executable_step_and_dag_dispatch",
      "description": "Clause condensation: from universally valid parent clause C, simultaneous substitution sigma, and conclusion clause D containing all literals of C sigma, the instance D is universally valid. Dispatched in proof DAGs via ProofNodeKind::Condensation; proven by condensation_sound to preserve universal validity.",
      "production_certification": false
    },
    {
      "id": "equality-reflexivity",
      "module": "first_order_core.rs",
      "status": "verified_executable_step_and_dag_dispatch",
      "description": "Equality reflexivity: the zero-parent unit equality clause t = t is universally valid. The DAG bridge also accepts the legacy one-parent annotation without using that parent. Dispatched via ProofNodeKind::Reflexivity; proven by equality_reflexivity_sound.",
      "production_certification": false
    },
    {
      "id": "equality-transitivity",
      "module": "first_order_core.rs",
      "status": "verified_executable_step_and_dag_dispatch",
      "description": "Equality transitivity: from parent clause C containing a positive equality literal s1 = s2 and unit positive equality parent t1 = t2, any chained conclusion u1 = u2 matching a transitive orientation while preserving all other literals is universally valid. This covers both unit equality clauses and arbitrary multi-literal clauses. Dispatched in proof DAGs via ProofNodeKind::Transitivity; proven by clause_transitivity_sound and equality_transitivity_sound to preserve universal validity.",
      "production_certification": false
    },
    {
      "id": "equality-symmetry",
      "module": "first_order_core.rs",
      "status": "verified_executable_step_and_dag_dispatch",
      "description": "Equality symmetry: from parent clause C containing an equality literal s = t (or s != t), commuting the equality to t = s (or t != s) while preserving all other literals derives a universally valid clause. Dispatched in proof DAGs via ProofNodeKind::Symmetry; proven by clause_symmetry_sound and equality_symmetry_sound to preserve universal validity.",
      "production_certification": false
    },
    {
      "id": "clause-excluded-middle",
      "module": "first_order_core.rs",
      "status": "verified_executable_step_and_dag_dispatch",
      "description": "Clause excluded middle (law of excluded middle): for any atom A, the zero-parent binary clause A | ~A (or ~A | A) is universally valid. The DAG bridge also accepts the legacy one-parent annotation without using that parent. Dispatched via ProofNodeKind::ExcludedMiddle; proven by excluded_middle_sound.",
      "production_certification": false
    },
    {
      "id": "equality-congruence",
      "module": "first_order_core.rs",
      "status": "verified_executable_step_and_dag_dispatch",
      "description": "Equality congruence: from parent clause C containing a positive equality literal s = t, derive C with that literal replaced by C[s] = C[t] (or C[t] = C[s]) in either orientation through any nonempty single-hole unary/binary function context, with exact symbols and unchanged siblings, while preserving all other literals. This covers both unit equality clauses and arbitrary multi-literal clauses. Dispatched in proof DAGs via ProofNodeKind::Congruence; proven by clause_congruence_sound, equality_congruence_sound, and oriented_congruence_preserves_value to preserve universal validity.",
      "production_certification": false
    },
    {
      "id": "clause-tautology",
      "module": "first_order_core.rs",
      "status": "verified_executable_step_and_dag_dispatch",
      "description": "Clause tautology: any zero-parent clause containing a reflexive equality literal s = s or a complementary pair of literals A and ~A is universally valid. The DAG bridge also accepts the legacy one-parent annotation without using that parent. Dispatched via ProofNodeKind::Tautology; proven by clause_tautology_sound.",
      "production_certification": false
    },
    {
      "id": "proof-dag-refutation",
      "module": "first_order_core.rs",
      "status": "verified_ir_dag_certification",
      "description": "certify_dag proves no well-formed interpretation satisfies the supplied universally closed IR inputs. Per-node support includes exact input membership, superposition, nullary and exact-atom resolution, first-order resolution, equality resolution, clause and equality factoring, subsumption resolution, weakening, demodulation, clause instantiation, clause condensation, equality reflexivity, equality transitivity, equality symmetry, clause excluded middle, equality congruence, and clause tautology. Wire v1 decoding is verified; the CNF TPTP bridge remains trusted and provides opt-in MRS shadow and dual-check APIs.",
      "production_certification": false
    }
  ],
